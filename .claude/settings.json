{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableClaudeAiConnectors": true,
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60"
  },
  "permissions": {
    "deny": [
      "Read(./package-lock.json)",
      "Read(./**/*.zip)",
      "Read(./branding/**)",
      "Read(./.next/**)",
      "Read(./node_modules/**)"
    ]
  }
}
