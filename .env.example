# Obrigatório no Vercel (Production) — copie do Supabase → Project Settings → Database
# DATABASE_URL = Transaction pooler (porta 6543) — runtime / queries do site
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL = Direct connection (porta 5432) — só migrations / prisma db push
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Sessão admin (JWT) — RECOMENDADO definir no Vercel: openssl rand -base64 48
# Se ausente, o app deriva um segredo da SUPABASE_SERVICE_ROLE_KEY (não há mais
# nenhum valor padrão no repositório).
# JWT_SECRET=

# Bootstrap do admin — NUNCA cria/reseta nada sem esta var explícita (min. 8 chars).
# Defina temporariamente só em fluxo de instalação e remova depois.
# ADMIN_BOOTSTRAP_PASSWORD=

# Senha usada pelo prisma/seed.ts (se ausente, o seed gera uma aleatória e imprime).
# SEED_ADMIN_PASSWORD=

# Upload de fotos (opcional no começo)
NEXT_PUBLIC_SUPABASE_URL="https://[REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Consulta de placa/FIPE no admin via placafipe.com (sem token)
# Fonte: https://placafipe.com/placa/{PLACA}

# Google Analytics 4 (opcional — já há default de produção no código)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-B1L2105B12

# Meta Pixel (tráfego / catálogo). Tem que ser o Pixel ligado ao dataset do
# catálogo "Garagem - Estoque de Veículos". Em Commerce Manager o dataset
# aparece como 1722250562674449; o Pixel do site (produção) é este ID.
# content_ids das fichas = Prisma CUID = coluna vehicle_id do feed.
# Também configure no Vercel (Production + Preview): NEXT_PUBLIC_META_PIXEL_ID
NEXT_PUBLIC_META_PIXEL_ID=2242212449873818

# Alerta de lead (opcional). Se falhar, o pedido ainda é salvo.
# LEAD_WEBHOOK_URL=https://example.com/hooks/leads
# RESEND_API_KEY=re_xxxxxxxxx
# LEAD_NOTIFY_EMAIL=suagaragem2@gmail.com
# LEAD_NOTIFY_FROM="Garagem <nao-responda@suagaragem.net>"

# Rate limit compartilhado entre pods (opcional). Sem isso, cada instância
# usa o contador em memória.
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Feed agendado do catálogo Meta (Automotive Inventory Ads), só estoque disponível.
# Cole no Commerce Manager → Fontes de dados → Feed agendado (a cada hora):
# https://www.suagaragem.net/api/meta/catalog.csv
# Alias equivalente: https://www.suagaragem.net/catalog/meta.csv
# Sem consignados: acrescente ?consigned=0
# vehicle_id = Prisma CUID = content_ids do Pixel (content_type=vehicle).
# Pixel de produção: NEXT_PUBLIC_META_PIXEL_ID (também aceita NEXT_PUBLIC_FB_PIXEL_ID).

# URL pública do Google Maps / Google Meu Negócio (opcional).
# Se vazia, o rodapé e o JSON-LD sameAs NÃO incluem Maps — não invente URL.
# Também pode ser preenchida em Admin → Site → URL do Google Meu Negócio.
# NEXT_PUBLIC_GOOGLE_MAPS_URL=

# Chatbot do site (Google AI Studio / Gemini). Só o nome — o valor fica
# no Vercel / Cursor Secrets, nunca no repositório.
# No Vercel: marque Production E Preview. Depois de criar/editar a var, Redeploy.
# Sem a chave, o chat ainda responde estoque/financiamento/garantia pelo banco.
GEMINI_API_KEY=
# Modelo do chat (opcional). Padrão: gemini-3.5-flash-lite, com gemini-2.5-flash-lite
# de reserva automática se a chave não tiver acesso (404/403 de modelo).
# O modelo que respondeu aparece no log "[chat] turn" (campo model).
# GEMINI_MODEL=gemini-3.5-flash-lite
# Raciocínio dos Gemini 3.x: minimal (padrão), low, medium ou high. Em "low" o 3.5
# Flash-Lite chegou a devolver resposta vazia; deixe em minimal.
# GEMINI_THINKING_LEVEL=minimal
# Segundo modelo da cadeia (padrão gemini-2.5-flash-lite): entra em erro, 404/403 ou resposta vazia.
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# Terceira reserva: DeepSeek V4.1 Flash via OpenRouter. Só entra se os dois Gemini falharem
# (erro, cota/429, créditos ou resposta vazia). Só no servidor; sem a chave a reserva é pulada.
# Vercel: Production e Preview.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Só para teste fora da produção (ignorado com VERCEL_ENV=production):
# openrouter pula os Gemini; gemini-fallback pula só o 3.5.
# CHAT_FORCE_FALLBACK=openrouter

# Nota do anúncio no admin (Jev / TypeSafe). Só no servidor — não use NEXT_PUBLIC_.
# No Vercel: Production e Preview. Sem a chave, o admin segue normal, sem a nota,
# e o salvamento não trava. A checagem de fotos e campos vazios continua local.
# JEV_API_KEY=
