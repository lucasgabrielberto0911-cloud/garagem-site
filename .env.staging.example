# Configuração de conexão do banco de Staging (Supabase Preview)
# Usado pelo CI (GitHub Actions) e localmente para validar schema drift antes do deploy.

# DATABASE_URL_STAGING = Transaction pooler (porta 6543) do Supabase Staging
DATABASE_URL_STAGING="postgresql://postgres.[STAGING_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL_STAGING = Conexão direta (porta 5432) do Supabase Staging
# Preferencial para DDL, migrations e verificação de drift via prisma migrate diff
DIRECT_URL_STAGING="postgresql://postgres.[STAGING_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Como configurar no GitHub Actions:
# 1. Acesse o repositório no GitHub: Settings -> Secrets and variables -> Actions
# 2. Em "Repository secrets", adicione:
#    - DATABASE_URL_STAGING
#    - DIRECT_URL_STAGING
#
# Como rodar a validação localmente:
# DIRECT_URL_STAGING="postgresql://..." npm run prisma:validate:staging
# ou
# DATABASE_URL_STAGING="postgresql://..." npm run prisma:validate:staging
