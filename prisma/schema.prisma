generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Vehicle {
  id           String   @id @default(cuid())
  /** "carro" | "moto" — define opções e acessórios do anúncio. */
  category     String   @default("carro")
  brand        String
  model        String
  version      String?
  year         Int
  yearModel    Int
  km           Int
  price        Float
  /** Preço de referência FIPE (uso interno do admin — nunca exibir no site). */
  fipePrice    Float?
  /** Placa completa — uso interno do admin (nunca exibir no site). */
  plate        String?
  /** Chassi (17 caracteres) — uso interno do admin, sai no contrato. Nunca exibir no site. */
  chassis      String?
  /** RENAVAM (11 dígitos) — uso interno do admin, sai no contrato. Nunca exibir no site. */
  renavam      String?
  fuel         String
  transmission String
  color        String?
  description  String?
  /** Motor / cilindrada — ex.: "2.0 TSI", "500cc". */
  engine       String?
  /** Portas (carros). Null em motos. */
  doors        Int?
  /** Garantia anunciada — ex.: "3 meses", "Garantia de fábrica". */
  warranty     String?
  /** Final da placa — ex.: "1", "2/3". */
  plateEnd     String?
  /** Laudo / vistoria — ex.: "Cautelar aprovado", "Com laudo". */
  inspection   String?
  /**
   * Já existe vídeo do veículo (WhatsApp / Instagram / arquivo interno).
   * Não é player no site — só qualidade do anúncio no painel.
   */
  hasVideo     Boolean  @default(false)
  /** Itens/acessórios do anúncio (checklist + pontos manuais). */
  accessories  String[] @default([])
  status       String   @default("disponivel")
  /**
   * Cidade física do veículo no ES: "serra" | "linhares".
   * Fonte da verdade do admin — não inferir pelo modelo.
   */
  locationCity String   @default("linhares")
  featured     Boolean  @default(false)
  /**
   * Venda registrada fora do estoque do site (ex.: negócio antes do site).
   * Não deve aparecer na vitrine pública.
   */
  historical   Boolean  @default(false)
  /** Documento já transferido para a loja (uso interno). */
  inStoreName  Boolean  @default(false)
  hasSpareKey  Boolean  @default(false)
  hasManual    Boolean  @default(false)
  /** Preço de aquisição — nunca exibir no site. */
  purchasePrice Float?
  /**
   * Carro de terceiro vendido pela loja (uso interno do admin — nunca exibir
   * no site). Fica na vitrine normalmente, mas compra e custos não entram no
   * valor do estoque nem no lucro.
   */
  consigned    Boolean  @default(false)
  // shortcut: reativar no Client só após validar a migração 20261022180400 nos bancos atendidos.
  soldAt       DateTime? @ignore
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  photos       Photo[]
  sale         Sale?
  costs        VehicleCost[]
  documents    VehicleDocument[]
  verifiedInfo VehicleVerifiedInfo?
  listingScore VehicleListingScore?
  priceHistory VehiclePriceHistory[]
  reservations VehicleReservation[]
  assessment VehicleAssessment?
  simulations FinanceSimulation[]
  commercialDocuments CommercialDocument[]

  @@index([status, createdAt])
  @@index([status, price])
  @@index([status, brand])
  @@index([status, yearModel])
  @@index([status, km])
  @@index([status, featured])
  @@index([status, category])
  @@index([status, locationCity])
}

model Photo {
  id           String  @id @default(cuid())
  url          String
  /** Capa WebP 480×360 para cards. Null = usa `url` até o backfill. */
  thumbnailUrl String?
  order        Int     @default(0)
  vehicleId    String
  vehicle      Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, order])
}

model VehicleCost {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /** despachante | documentacao | ipva | mecanica | estetica | transporte | laudo | outro */
  kind        String
  description String   @default("")
  amount      Float
  incurredAt  DateTime @default(now())
  receiptUrl  String?
  receiptName String?
  createdAt   DateTime @default(now())

  @@index([vehicleId, incurredAt])
}

model VehicleDocument {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /** crlv | recibo | procuracao | laudo | nf | outro */
  kind      String
  title     String
  fileUrl   String
  fileName  String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([vehicleId])
}

/**
 * Informações verificadas daquele exemplar (revisões, pneus, interior, lataria,
 * documentação). Tabela própria e opcional: o Vehicle não ganha coluna, então
 * o site e o admin seguem funcionando se o SQL ainda não rodou
 * (supabase/migrations/20261010000100_info_verificada_veiculo.sql). `items` = lista de
 * { key, text, photoIds } — ver src/lib/vehicle-verified.ts.
 */
/**
 * Nota do anúncio pelo Jev, gravada só quando o admin salva uma alteração que
 * muda o texto avaliado. O admin mostra esta nota sem chamar o Jev de novo.
 */
model VehicleListingScore {
  id        String   @id @default(cuid())
  vehicleId String   @unique
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /** ListingJudgment devolvido pelo Jev. */
  judgment  Json
  /** sha256 do texto enviado ao Jev; igual = não chama de novo. */
  inputHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Histórico de preço (selo "Baixou o preço"): uma linha por mudança registrada no admin.
model VehiclePriceHistory {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  price     Float
  createdAt DateTime @default(now())

  @@index([vehicleId, createdAt])
}

model VehicleVerifiedInfo {
  id        String   @id @default(cuid())
  vehicleId String   @unique
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  items     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  updatedAt DateTime @default(now()) @updatedAt
  id        String   @id @default(cuid())
  name      String
  cpf       String?
  /** RG — uso interno do admin, sai no contrato. */
  rg        String?
  phone     String
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  sales     Sale[]
  reservations VehicleReservation[]
  promissoryNotes PromissoryNote[]
}

model Sale {
  id            String    @id @default(cuid())
  vehicleId     String    @unique
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id])
  /** Opcional — vendas históricas ou negócios sem cadastro de cliente. */
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  salePrice     Float
  paymentMethod String
  saleDate      DateTime  @default(now())
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  afterSaleTasks AfterSaleTask[]

  @@index([customerId])
  promissoryNotes PromissoryNote[]
}

model Admin {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String
}

model LeadVenda {
  id                String   @id @default(cuid())
  name              String
  phone             String
  vehicleInfo       String
  /** Placa normalizada (ABC1234 / ABC1D23), sem traço, maiúsculas. */
  plate             String   @default("")
  km                Int?
  notes             String?
  status            String   @default("novo")
  lostReason        String?
  nextAction        String?
  nextActionAt      DateTime?
  activities        LeadActivity[]
  /** Anúncio do estoque que originou o interesse (`/vender?interesse=`). */
  interestVehicleId String?
  /** Origem do formulário — hoje `vender`. */
  source            String?
  /** Refs privadas (`private://documentos/vender/...`) das fotos do usado. */
  photoUrls         String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, createdAt])
}

model Testimonial {
  id           String   @id @default(cuid())
  name         String
  city         String?
  message      String
  /** Nota de 1 a 5 — exibida na home. */
  rating       Int      @default(5)
  /** Veículo comprado (texto livre, opcional). */
  vehicleLabel String?
  photoUrl     String?
  published    Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
}

/**
 * Dados públicos editáveis pelo painel (endereço, e-mail, horário, região).
 * Singleton: sempre `id = "default"`. Campos vazios caem nos defaults de site.ts.
 */
model SiteSettings {
  id             String   @id @default("default")
  region         String?
  email          String?
  address        String?
  hours          String?
  hoursWeekdays  String?
  hoursSaturday  String?
  /** Valores exibidos em Sobre nós (ex.: "+20", "8h–23h"). */
  aboutYears     String?
  /** @deprecated Use statsSalesBase — mantido só para migração legada. */
  aboutSold      String?
  aboutHours     String?
  aboutFocus     String?
  /**
   * Base somada aos veículos disponíveis reais (home).
   * Exibido = statsStockBase + count(status=disponivel).
   */
  statsStockBase Int      @default(0)
  /**
   * Base somada às vendas reais (home + Sobre "carros vendidos").
   * Exibido = statsSalesBase + count(Sale).
   */
  statsSalesBase Int      @default(0)
  /** Nota do Google Meu Negócio (0 = oculto no site). */
  googleRating      Float   @default(0)
  googleReviewCount Int     @default(0)
  googleProfileUrl  String?
  /** FAQ pública. Null = usa o texto-base de faq.ts. */
  faqJson           Json?
  conditionsTitle   String?
  conditionsIntro   String?
  /** Itens do bloco garantia/condições na ficha. Null = vehicle-conditions.ts. */
  conditionsJson    Json?
  /** Foto original do sócio na página Sobre. URL pública do Storage, ou vazia. */
  founderPhotoUrl String?
  updatedAt      DateTime @updatedAt
}

/** Rascunhos privados; nunca entram em Vehicle nem na vitrine. */
model AdminDraft {
  id String @id @default(cuid())
  adminId String
  key String
  payload Json
  photoUrls String[] @default([])
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  @@unique([adminId, key])
  @@index([expiresAt])
}
/** Histórico interno sem senhas, documentos ou dados de contato. */
model AdminAudit {
  id String @id @default(cuid())
  adminId String
  entityId String
  action String
  changes Json
  createdAt DateTime @default(now())
  @@index([entityId, createdAt])
  @@index([createdAt])
}
/** Contador compartilhado de tentativas; a chave não contém e-mail/IP legíveis. */
model AdminLoginAttempt {
  key String @id
  count Int @default(1)
  expiresAt DateTime
}
model LeadActivity {
  id String @id @default(cuid())
  leadId String
  lead LeadVenda @relation(fields: [leadId], references: [id], onDelete: Cascade)
  adminId String
  note String
  createdAt DateTime @default(now())
  @@index([leadId, createdAt])
}

model VehicleReservation {
  id String @id @default(cuid())
  vehicleId String
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  deposit Decimal @db.Decimal(12, 2)
  expiresAt DateTime
  status String @default("ativa")
  createdAt DateTime @default(now())
  @@index([status, expiresAt])
  @@index([vehicleId])
}

model VehicleAssessment {
  vehicleId String @id
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  items Json
  notes String
  offer Decimal @db.Decimal(12, 2)
  approved Boolean @default(false)
  updatedAt DateTime @updatedAt
}

model FinanceSimulation {
  id String @id @default(cuid())
  vehicleId String
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customerName String
  bank String
  price Decimal @db.Decimal(12, 2)
  downPayment Decimal @db.Decimal(12, 2)
  rate Decimal @db.Decimal(6, 3)
  months Int
  installment Decimal @db.Decimal(12, 2)
  status String @default("simulacao")
  createdAt DateTime @default(now())
  @@index([vehicleId, createdAt])
}

model CommercialDocument {
  id String @id @default(cuid())
  vehicleId String
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  kind String
  number Int @unique @default(autoincrement())
  snapshot Json
  createdAt DateTime @default(now())
  @@index([vehicleId, createdAt])
}

model AfterSaleTask {
  id String @id @default(cuid())
  saleId String
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  kind String
  dueAt DateTime
  completedAt DateTime?
  @@unique([saleId, kind])
  @@index([completedAt, dueAt])
}

/** Nota promissória emitida pela loja (aba Promissórias do admin). Os dados do emitente são copiados na emissão. */
model PromissoryNote {
  issuanceKey String?
  issuanceHash String?
  id String @id @default(cuid())
  number Int @unique @default(autoincrement())
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  issuerName String
  issuerCpf String
  issuerRg String?
  issuerBirthDate DateTime @db.Date
  issuerPhone String
  issuerAddress String
  amount Decimal @db.Decimal(12, 2)
  dueDate DateTime @db.Date
  issuedAt DateTime @db.Date
  issuePlace String
  paymentPlace String
  installmentNo Int @default(1)
  installmentCount Int @default(1)
  saleId String?
  sale Sale? @relation(fields: [saleId], references: [id], onDelete: SetNull)
  /// emitida | vinculada | paga | cancelada
  status String @default("emitida")
  paidAt DateTime?
  /// Aviso da baixa na agenda: nulo enquanto pendente.
  paidNoticeDoneAt DateTime?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([issuanceKey, installmentNo])
  @@index([status, dueDate])
  @@index([customerId])
  @@index([saleId])
  @@index([paidAt, paidNoticeDoneAt])
}

/** Carro comprado ainda em preparação (uso interno do painel; nunca entra na vitrine). */
model PreparationVehicle {
  id            String    @id @default(cuid())
  brand         String
  model         String
  color         String?
  year          Int?
  km            Int?
  plate         String?
  ready         Boolean   @default(false)
  posted        Boolean   @default(false)
  purchasedAt   DateTime?
  purchasePrice Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([createdAt])
}
