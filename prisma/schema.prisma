generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Vehicle {
  id           String   @id @default(cuid())
  /** "carro" | "moto" — define opções e acessórios do anúncio. */
  category     String   @default("carro")
  brand        String
  model        String
  version      String?
  year         Int
  yearModel    Int
  km           Int
  price        Float
  /** Preço de referência FIPE (uso interno do admin — nunca exibir no site). */
  fipePrice    Float?
  /** Placa completa — uso interno do admin (nunca exibir no site). */
  plate        String?
  fuel         String
  transmission String
  color        String?
  description  String?
  /** Motor / cilindrada — ex.: "2.0 TSI", "500cc". */
  engine       String?
  /** Portas (carros). Null em motos. */
  doors        Int?
  /** Garantia anunciada — ex.: "3 meses", "Garantia de fábrica". */
  warranty     String?
  /** Final da placa — ex.: "1", "2/3". */
  plateEnd     String?
  /** Laudo / vistoria — ex.: "Cautelar aprovado", "Com laudo". */
  inspection   String?
  /**
   * Já existe vídeo do veículo (WhatsApp / Instagram / arquivo interno).
   * Não é player no site — só qualidade do anúncio no painel.
   */
  hasVideo     Boolean  @default(false)
  /** Itens/acessórios do anúncio (checklist + pontos manuais). */
  accessories  String[] @default([])
  status       String   @default("disponivel")
  featured     Boolean  @default(false)
  /**
   * Venda registrada fora do estoque do site (ex.: negócio antes do site).
   * Não deve aparecer na vitrine pública.
   */
  historical   Boolean  @default(false)
  /** Documento já transferido para a loja (uso interno). */
  inStoreName  Boolean  @default(false)
  hasSpareKey  Boolean  @default(false)
  hasManual    Boolean  @default(false)
  /** Preço de aquisição — nunca exibir no site. */
  purchasePrice Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  photos       Photo[]
  sale         Sale?
  costs        VehicleCost[]
  documents    VehicleDocument[]

  @@index([status, createdAt])
  @@index([status, price])
  @@index([status, brand])
  @@index([status, yearModel])
  @@index([status, km])
  @@index([status, featured])
  @@index([status, category])
}

model Photo {
  id           String  @id @default(cuid())
  url          String
  /** Capa WebP 480×300 para cards. Null = usa `url` até o backfill. */
  thumbnailUrl String?
  order        Int     @default(0)
  vehicleId    String
  vehicle      Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, order])
}

model VehicleCost {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /** despachante | documentacao | ipva | mecanica | estetica | transporte | laudo | outro */
  kind        String
  description String   @default("")
  amount      Float
  incurredAt  DateTime @default(now())
  receiptUrl  String?
  receiptName String?
  createdAt   DateTime @default(now())

  @@index([vehicleId, incurredAt])
}

model VehicleDocument {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /** crlv | recibo | procuracao | laudo | nf | outro */
  kind      String
  title     String
  fileUrl   String
  fileName  String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([vehicleId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  cpf       String?
  phone     String
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  sales     Sale[]
}

model Sale {
  id            String    @id @default(cuid())
  vehicleId     String    @unique
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id])
  /** Opcional — vendas históricas ou negócios sem cadastro de cliente. */
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  salePrice     Float
  paymentMethod String
  saleDate      DateTime  @default(now())
  notes         String?
  createdAt     DateTime  @default(now())
}

model Admin {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String
}

model LeadVenda {
  id          String   @id @default(cuid())
  name        String
  phone       String
  vehicleInfo String
  /** Placa normalizada (ABC1234 / ABC1D23), sem traço, maiúsculas. */
  plate       String   @default("")
  km          Int?
  notes       String?
  status      String   @default("novo")
  createdAt   DateTime @default(now())
}

model Testimonial {
  id           String   @id @default(cuid())
  name         String
  city         String?
  message      String
  /** Nota de 1 a 5 — exibida na home. */
  rating       Int      @default(5)
  /** Veículo comprado (texto livre, opcional). */
  vehicleLabel String?
  photoUrl     String?
  published    Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
}

/**
 * Dados públicos editáveis pelo painel (endereço, e-mail, horário, região).
 * Singleton: sempre `id = "default"`. Campos vazios caem nos defaults de site.ts.
 */
model SiteSettings {
  id             String   @id @default("default")
  region         String?
  email          String?
  address        String?
  hours          String?
  hoursWeekdays  String?
  hoursSaturday  String?
  /** Valores exibidos em Sobre nós (ex.: "+20", "8h–23h"). */
  aboutYears     String?
  /** @deprecated Use statsSalesBase — mantido só para migração legada. */
  aboutSold      String?
  aboutHours     String?
  aboutFocus     String?
  /**
   * Base somada aos veículos disponíveis reais (home).
   * Exibido = statsStockBase + count(status=disponivel).
   */
  statsStockBase Int      @default(0)
  /**
   * Base somada às vendas reais (home + Sobre "carros vendidos").
   * Exibido = statsSalesBase + count(Sale).
   */
  statsSalesBase Int      @default(0)
  /** Nota do Google Meu Negócio (0 = oculto no site). */
  googleRating      Float   @default(0)
  googleReviewCount Int     @default(0)
  googleProfileUrl  String?
  /** FAQ pública. Null = usa o texto-base de faq.ts. */
  faqJson           Json?
  conditionsTitle   String?
  conditionsIntro   String?
  /** Itens do bloco garantia/condições na ficha. Null = vehicle-conditions.ts. */
  conditionsJson    Json?
  /** Foto original do sócio na página Sobre. URL pública do Storage, ou vazia. */
  founderPhotoUrl String?
  updatedAt      DateTime @updatedAt
}
